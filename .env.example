# =====================================================================
#  Copy this file to .env.local and fill in the values.
#  .env.local is git-ignored — never commit real keys.
#  On Hostinger, set these same three in hPanel → Node.js app → Environment.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → publishable key (sb_publishable_...)
# Safe to use server-side: the leads table has an INSERT-only RLS policy,
# so this key can add a lead but can never read, edit or delete one.
SUPABASE_PUBLISHABLE_KEY=

# Resend → API Keys → Create API Key (sending permission is enough)
RESEND_API_KEY=
