# sushantrana.com — Apache / LiteSpeed (Hostinger) rules for the static site.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

RewriteEngine On

# One canonical host: https + apex, in a single 301 hop.
RewriteCond %{HTTP_HOST} ^www\.sushantrana\.com$ [NC]
RewriteRule ^(.*)$ https://sushantrana.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^sushantrana\.com$ [NC]
RewriteRule ^(.*)$ https://sushantrana.com/$1 [R=301,L]

# Thank-you pages were renamed per form; old URLs keep working.
RewriteRule ^thank-you/?$ /thank-you-consultation/ [R=301,L]
RewriteRule ^services/shopify-store-development/thank-you/?$ /thank-you-shopify-store-development/ [R=301,L]
RewriteRule ^services/website-maintenance/thank-you/?$ /thank-you-website-maintenance/ [R=301,L]

# Long cache for files whose content never changes under the same name.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json image/svg+xml text/xml
</IfModule>

# Repo files that are not part of the site (notes, local dev router, DB
# migrations) — the whole repo is deployed, so hide them from visitors.
RedirectMatch 404 ^/(dev|supabase|_originals|includes|\.claude|\.git)(/|$)

RedirectMatch 404 \.md$
