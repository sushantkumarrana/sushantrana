# sushantrana.com — Apache / LiteSpeed (Hostinger) rules for the static site.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
# llms.txt and llms-full.txt hold ₹, — and ✓; without this they show as mojibake.
AddType "text/plain; charset=utf-8" .txt

RewriteEngine On

# One canonical host: https + apex, in a single 301 hop.
RewriteCond %{HTTP_HOST} ^www\.sushantrana\.com$ [NC]
RewriteRule ^(.*)$ https://sushantrana.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^sushantrana\.com$ [NC]
RewriteRule ^(.*)$ https://sushantrana.com/$1 [R=301,L]

# /about/index.html -> /about/ (one URL per page). THE_REQUEST: only what the
# browser asked for, so DirectoryIndex's internal index.html never loops.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Thank-you pages were renamed per form; old URLs keep working.
RewriteRule ^thank-you/?$ /thank-you-consultation/ [R=301,L]
RewriteRule ^services/shopify-store-development/thank-you/?$ /thank-you-website/ [R=301,L]
RewriteRule ^services/website-maintenance/thank-you/?$ /thank-you-website/ [R=301,L]
# thank-you pages merged into one per service group (GA4 lead_<group> events)
RewriteRule ^thank-you-google-ads/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-meta-ads/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-performance-marketing/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-google-shopping-ads/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-amazon-ads/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-linkedin-ads/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-youtube-ads/?$ /thank-you-paid-ads/ [R=301,L]
RewriteRule ^thank-you-local-seo/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-google-business-profile/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-technical-seo/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-seo-audit/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-ecommerce-seo/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-on-page-seo/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-link-building/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-enterprise-seo/?$ /thank-you-seo/ [R=301,L]
RewriteRule ^thank-you-shopify-store-development/?$ /thank-you-website/ [R=301,L]
RewriteRule ^thank-you-wordpress-development/?$ /thank-you-website/ [R=301,L]
RewriteRule ^thank-you-website-maintenance/?$ /thank-you-website/ [R=301,L]
RewriteRule ^thank-you-landing-pages/?$ /thank-you-website/ [R=301,L]
RewriteRule ^thank-you-gohighlevel/?$ /thank-you-crm-automation/ [R=301,L]
RewriteRule ^thank-you-hubspot-crm/?$ /thank-you-crm-automation/ [R=301,L]
RewriteRule ^thank-you-zoho-crm/?$ /thank-you-crm-automation/ [R=301,L]
RewriteRule ^thank-you-email-automation/?$ /thank-you-crm-automation/ [R=301,L]
RewriteRule ^thank-you-sales-funnel-setup/?$ /thank-you-crm-automation/ [R=301,L]
RewriteRule ^thank-you-real-estate-marketing/?$ /thank-you-industry/ [R=301,L]
RewriteRule ^thank-you-dental-marketing/?$ /thank-you-industry/ [R=301,L]
RewriteRule ^thank-you-law-firm-marketing/?$ /thank-you-industry/ [R=301,L]
RewriteRule ^thank-you-education-marketing/?$ /thank-you-industry/ [R=301,L]
RewriteRule ^thank-you-auto-repair-marketing/?$ /thank-you-industry/ [R=301,L]

# Long cache for files whose content never changes under the same name.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json image/svg+xml text/xml
</IfModule>

# Repo files that are not part of the site (notes, local dev router, DB
# migrations) — the whole repo is deployed, so hide them from visitors.
RedirectMatch 404 ^/(dev|supabase|_originals|includes|\.claude|\.git)(/|$)
RedirectMatch 404 ^/\.gitignore$

RedirectMatch 404 \.md$

# Security headers. No Content-Security-Policy yet: GTM injects third-party
# tags chosen in the GTM dashboard, so a policy needs that tag list first.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
